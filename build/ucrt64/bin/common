# Job parallelism is determined by the number of available logical cores.
JOBS=$(grep processor /proc/cpuinfo | wc -l)

ROOTDIR="$(realpath -s "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../..")"

source <(sed 's/[[:space:]]*=[[:space:]]*/=/g' "$ROOTDIR/VERSION")

VIMDIR="$ROOTDIR/vim"

CONTRIBDIR="$ROOTDIR/contrib"
KAORIYADIR="$ROOTDIR/kaoriya"
PATCHDIR="$ROOTDIR/patches"

VIM_MAKE_FLAGS=()

LICENSES=(
  "libiconv /${MSYSTEM,,}/share/licenses/libiconv/COPYING"
  "gettext  /${MSYSTEM,,}/share/licenses/gettext/COPYING"
  "xpm-nox  /${MSYSTEM,,}/share/licenses/xpm-nox/COPYRIGHT"
)

if [[ -r "config" ]] ; then
  source "config"
fi

_msg_info() {
  echo "INFO: $@"
}

_msg_error() {
  echo "[41;97mERROR: $@[0m"
}

_msg_ok() {
  echo "[42;97mOK: $@[0m"
}

# vim:set ft=sh:
