export MSYS2_ARG_CONV_EXCL="*"

ROOTDIR="$(realpath -s "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../..")"

source <(sed 's/[[:space:]]*=[[:space:]]*/=/g' "$ROOTDIR/VERSION")

VIMDIR="$ROOTDIR/vim"

CONTRIBDIR="$ROOTDIR/contrib"
KAORIYADIR="$ROOTDIR/kaoriya"
PATCHDIR="$ROOTDIR/patches"

VIM_MAKE_FLAGS=()

LICENSES=(
  "libiconv     $CONTRIBDIR/libiconv2/COPYING.LIB"
  "gettext      $CONTRIBDIR/gettext/gettext-runtime/intl/COPYING.LIB-2.1"
  "libXpm-win32 $CONTRIBDIR/libXpm-win32/COPYING"
)

if [[ -r "config" ]] ; then
  source "config"
fi

_msg_info() {
  echo "INFO: $@"
}

_msg_error() {
  echo "[41;97mERROR: $@[0m"
}

_msg_ok() {
  echo "[42;97mOK: $@[0m"
}

# vim:set ft=sh:
